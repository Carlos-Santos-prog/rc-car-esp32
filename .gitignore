# ============================================================
#  RC Car ESP32 - .gitignore
# ============================================================

# --- KiCad: copias de seguridad y archivos locales ---
*-backups/
*.bak
*.b#?
*.kicad_prl
fp-info-cache
fp-info-cache/
*.lck
~*.lck
_autosave-*

# --- Salidas de fabricación (se regeneran con Fabrication Toolkit) ---
# Descomenta si prefieres no versionar los Gerbers:
# gerbers/
# *.gbr
# *.drl
# *.gbrjob

# --- Sistema operativo ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Editores / IDE ---
.vscode/
.idea/
*.swp
*~

# --- Firmware / tooling (para cuando se añada el código del ESP32) ---
__pycache__/
*.py[cod]
.pio/
.pioenvs/
.piolibdeps/
